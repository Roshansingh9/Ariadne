# Copy to .env for local development (never commit .env). Placeholders only.

# --- FalkorDB Cloud (primary graph store) ---
FALKORDB_HOST=your-instance.falkordb.cloud
FALKORDB_PORT=6379
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=
# true only if the endpoint accepts TLS on this port (some FalkorDB Cloud tiers don't; then keep false)
FALKORDB_SSL=false
# Prefix for per-repository graph names: <prefix>:<host>__<owner>__<repo>
FALKORDB_GRAPH_NAME=ariadne
FALKORDB_TIMEOUT=30

# --- Meta Model API (natural-language answers) ---
# META_API_KEY is canonical; MODEL_API_KEY (the name Meta's docs use) is accepted as an alias.
META_API_KEY=
# META_BASE_URL is accepted as an alias for META_API_BASE_URL.
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_API_TIMEOUT=45

# --- Write protection ---
# Shared secret required (header X-Ariadne-Token) to index or delete repositories.
# REQUIRED on Vercel: without it, indexing and deletion are disabled there (503). Optional locally.
ARIADNE_INDEX_TOKEN=

# --- Optional ---
# Raises the GitHub API rate limit for repository metadata lookups
GITHUB_TOKEN=
# Indexing bounds (serverless-safe defaults)
ARIADNE_MAX_FILES=1500
ARIADNE_MAX_FILE_KB=400
ARIADNE_MAX_ARCHIVE_MB=60
ARIADNE_MAX_SOURCE_MB=25
ARIADNE_FETCH_TIMEOUT=60
# Whole-index time budget; keep below vercel.json maxDuration (300)
ARIADNE_INDEX_DEADLINE_SECONDS=270
